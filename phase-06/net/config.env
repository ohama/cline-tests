# phase-06/net/config.env — sourced by every Phase 6 network-exposure script.
#
# This is the ONLY place any Phase 6 port/host/LAN/label value is defined —
# same convention as phase-02/infra/config.env, phase-03/sandbox/config.env,
# phase-04/config.env, phase-05/services/config.env. Every value below uses
# the `${VAR:-default}` override idiom so a caller can override any single
# value without editing this file.

# Derive PROJECT_ROOT from this script's own location so config.env is
# source-able from any cwd. This file lives at phase-06/net/config.env, so
# PROJECT_ROOT is two directories up.
_CONFIG_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$_CONFIG_ENV_DIR/../.." && pwd)}"

# ---- REUSE, DO NOT RE-DERIVE ------------------------------------------------
# Pre-set RESULTS_ROOT to phase-06's own results dir BEFORE sourcing
# phase-05/services/config.env. phase-05/services/config.env's own
# RESULTS_ROOT assignment uses the `${RESULTS_ROOT:-...}` idiom, so a value
# already set here wins and phase-05's results dir is never touched by
# phase-06 scripts. Sourcing it gives us KANBAN_HOST/KANBAN_PORT/
# TELEGRAM_LABEL/KANBAN_LABEL/LAUNCH_AGENTS_DIR/MIRROR_AGENTS_DIR/
# STAGED_PLISTS_DIR/SERVICE_LOG_DIR without re-deriving any of them a second
# time in a second place. Ordering matters: source AFTER the pre-set, or
# phase-05's own default would win instead.
RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/phase-06/results}"
# shellcheck source=/dev/null
source "$PROJECT_ROOT/phase-05/services/config.env"

# ---- Tailscale binary / tailnet identity ------------------------------------
TAILSCALE_BIN="${TAILSCALE_BIN:-/opt/homebrew/bin/tailscale}"
TAILNET_HOSTNAME="${TAILNET_HOSTNAME:-ohama-2.tail318f12.ts.net}"
TAILNET_IP4="${TAILNET_IP4:-100.118.140.2}"

# ---- TS_SERVE_PORT (load-bearing — this is the NET-01/NET-03 correctness
# question, not a style choice) -----------------------------------------------
# 8444 was confirmed genuinely unclaimed by `lsof -nP -iTCP:8444` immediately
# before this file was written (see phase-06/results/*-baseline/inventory.txt
# for the live check). It is deliberately NOT any of 3000, 443, 8443, or
# 10000:
#   - 3000 must stay unbound: this Mac already has a pre-existing, live
#     public-exposure entry on :8443 forwarding to 127.0.0.1:3000. Anything
#     that binds 3000 becomes world-reachable with no tailnet login at all.
#   - 443, 8443, 10000 are already claimed by three pre-existing handlers
#     that pre-date this project (see EXPECTED_SERVE_BASELINE below) and are
#     out of scope — record them, never touch them. 8443 specifically is the
#     live public-exposure port itself.
TS_SERVE_PORT="${TS_SERVE_PORT:-8444}"

# ---- Kanban host-rewrite proxy — BEHAVIOURAL constants (load-bearing —
# added by 06-04.1 to unblock 06-04) ------------------------------------
# KANBAN_PROXY_LABEL/KANBAN_PROXY_PORT are this component's IDENTITY and
# are defined exactly once, in phase-05/services/config.env (the
# project-wide launchd label/port registry, sourced above) — not
# re-derived here. This block owns everything about how the proxy BEHAVES:
# what it binds, what it forwards to, and what Host/Origin values it will
# accept. That split (identity in Phase 5's registry, behaviour in Phase
# 6's own config) mirrors how KANBAN_LABEL/KANBAN_PORT vs. this file's own
# TS_SERVE_PORT/TS_SERVE_TARGET are already split.
#
# NODE_BIN: kanban itself is a `#!/usr/bin/env node` shebang script and both
# Phase 5 plists already pin /opt/homebrew/bin on PATH for exactly that
# reason, so node is already a hard dependency of this project's kanban
# service — using it for the proxy too adds no new dependency.
NODE_BIN="${NODE_BIN:-/opt/homebrew/bin/node}"
# The proxy must bind loopback and ONLY loopback — say so in prose, never
# with a wildcard address literal (see verify_network.sh check 13, which
# greps this repo for that literal and would flag its own needle if a file
# ever wrote it in cleartext).
KANBAN_PROXY_HOST="${KANBAN_PROXY_HOST:-127.0.0.1}"
# A scratch port distinct from the real service port (KANBAN_PROXY_PORT),
# used only by Task 1's bounded, hand-run, non-launchd smoke test — the
# same "prove on a throwaway port before it's ever real" discipline
# TS_SERVE_SCRATCH_PORT already established for the Serve entry itself.
KANBAN_PROXY_SCRATCH_PORT="${KANBAN_PROXY_SCRATCH_PORT:-18485}"
KANBAN_PROXY_SCRIPT="${KANBAN_PROXY_SCRIPT:-$PROJECT_ROOT/phase-06/net/kanban_host_proxy.js}"
KANBAN_PROXY_WRAPPER="${KANBAN_PROXY_WRAPPER:-$PROJECT_ROOT/phase-06/net/run_kanban_proxy_service.sh}"
# What the proxy rewrites Host/Origin TO before forwarding upstream to
# kanban — kanban's own compiled getAllowedHostHeaders()/getKanbanRuntimeOrigin()
# only ever accept these loopback values while kanban is loopback-bound.
PROXY_UPSTREAM_HOST_HEADER="${PROXY_UPSTREAM_HOST_HEADER:-$KANBAN_HOST:$KANBAN_PORT}"
PROXY_UPSTREAM_ORIGIN="${PROXY_UPSTREAM_ORIGIN:-http://$KANBAN_HOST:$KANBAN_PORT}"
# The app's own tailnet-facing origin — the only origin the proxy ever
# launders INTO the upstream-allowed value on the way back out.
PROXY_PUBLIC_ORIGIN="${PROXY_PUBLIC_ORIGIN:-https://$TAILNET_HOSTNAME:$TS_SERVE_PORT}"
# What the proxy itself accepts on the way IN, translating (not removing)
# kanban's own defense: the tailnet Host (with and without the Serve port,
# MagicDNS resolution can present either), plus its own loopback identity
# for local probes (Task 1's smoke test, Task 2's post-restart re-probe,
# and verify_network.sh's own checks all curl the proxy directly on
# loopback with an explicit Host header, so the proxy's own loopback
# identity must be in its own allowlist too).
PROXY_ALLOWED_HOSTS="${PROXY_ALLOWED_HOSTS:-$TAILNET_HOSTNAME:$TS_SERVE_PORT $TAILNET_HOSTNAME 127.0.0.1:$KANBAN_PROXY_PORT localhost:$KANBAN_PROXY_PORT}"
PROXY_ALLOWED_ORIGINS="${PROXY_ALLOWED_ORIGINS:-$PROXY_PUBLIC_ORIGIN http://127.0.0.1:$KANBAN_PROXY_PORT http://localhost:$KANBAN_PROXY_PORT}"

# TS_SERVE_TARGET now names the proxy (127.0.0.1:$KANBAN_PROXY_PORT), not
# kanban directly (127.0.0.1:$KANBAN_PORT). Chain:
#   tailscale serve :8444 -> proxy(127.0.0.1:18484) -> kanban(127.0.0.1:3484)
# 06-04 proved the Serve mechanics are correct and then hit kanban's own
# compiled Host allowlist (getAllowedHostHeaders() in dist/cli.js), which
# hardcodes {localhost:<port>, 127.0.0.1:<port>} while loopback-bound with
# no flag/env override. The proxy translates the client-presented tailnet
# Host/Origin into the loopback pair kanban already accepts. This single
# edit re-points both setup_tailscale_serve.sh's apply command and
# verify_network.sh check 4 with no script change. Kanban's bind still does
# not change — only what sits in front of it does (see the "Kanban's bind"
# block further below, left byte-identical otherwise).
TS_SERVE_TARGET="${TS_SERVE_TARGET:-http://$KANBAN_PROXY_HOST:$KANBAN_PROXY_PORT}"
TS_SERVE_URL="${TS_SERVE_URL:-https://$TAILNET_HOSTNAME:$TS_SERVE_PORT/}"

# Every `tailscale` invocation on this Mac prints a client/daemon version
# mismatch warning to stderr — pre-existing and benign (macOS App Store
# "macsys" daemon vs. the Homebrew CLI point release talking to it). Filter
# it; never gate success on stderr being empty.
TS_WARN_FILTER="${TS_WARN_FILTER:-^Warning: client version}"

FORBIDDEN_SERVE_PORTS="${FORBIDDEN_SERVE_PORTS:-3000 443 8443 10000}"

# The single pre-existing public-exposure key, frozen for byte-identity
# comparison by later plans (see expected_serve_baseline.json, written by
# Task 2 of this plan). Phase 6 must never add a second one.
EXPECTED_FUNNEL_KEY="${EXPECTED_FUNNEL_KEY:-ohama-2.tail318f12.ts.net:8443}"
EXPECTED_FUNNEL_KEY_COUNT="${EXPECTED_FUNNEL_KEY_COUNT:-1}"
EXPECTED_SERVE_BASELINE="${EXPECTED_SERVE_BASELINE:-$PROJECT_ROOT/phase-06/net/expected_serve_baseline.json}"

TELEGRAM_ALLOWED_USER_ID_KEY="${TELEGRAM_ALLOWED_USER_ID_KEY:-TELEGRAM_ALLOWED_USER_ID}"

# Deliberately fake/invalid — used only to exercise NET-04's wrapper-level
# pre-flight guard shape without ever touching a real Telegram bot token.
NET04_PROBE_TOKEN="${NET04_PROBE_TOKEN:-000000:NET04-GUARD-PROBE-NOT-A-REAL-TOKEN}"

# ---- TS_SERVE_ROLLBACK_CMD (load-bearing — this is not a style choice) -----
# Hardcoded here, once, rather than derived at call time, because this
# tailscale version's `serve --help` documents NO per-port removal syntax at
# all. The only removal-shaped verbs it shows are:
#   - `reset` — wipes the ENTIRE serve config, including the two out-of-scope
#     pre-existing handlers and the pre-existing public-exposure key. Running
#     it would be an outright violation of "record it, don't touch it."
#   - `clear <service>` — applies only to named `--service` targets, not to
#     plain port entries like ours; not applicable here.
# The correct single-port form is `serve --https=<port> off`; it is
# undocumented in `--help` but confirmed accepted by this version. So it is
# pinned here, once, and 06-03 Task 3 exercises it against
# TS_SERVE_SCRATCH_PORT to prove the syntax before it is ever needed for
# real.
#
# `reset` must never appear as a rollback command anywhere under phase-06/.
TS_SERVE_ROLLBACK_CMD="${TS_SERVE_ROLLBACK_CMD:-$TAILSCALE_BIN serve --https=$TS_SERVE_PORT off}"

# Unclaimed (confirmed by `lsof -nP -iTCP:59999` immediately before this file
# was written); used only to exercise the rollback syntax above on a scratch
# entry before it is ever relied on for kanban's real entry.
TS_SERVE_SCRATCH_PORT="${TS_SERVE_SCRATCH_PORT:-59999}"

# ---- Kanban's bind (load-bearing — this is not a style choice) -------------
# Kanban's bind is NEVER changed by anything in Phase 6. It stays
# `--host 127.0.0.1 --port 3484` (KANBAN_HOST/KANBAN_PORT, sourced above,
# unmodified). `--host 127.0.0.1` is what keeps kanban's own remote-access
# passcode gate permanently OFF for anyone arriving via the Tailscale-Serve
# route: `isKanbanRemoteHost()` is decided once, at process start, purely
# from the --host value — not evaluated per incoming connection. Kanban never
# sees a non-loopback bind, so the passcode gate never turns on, for any
# caller, tailnet or otherwise.
#
# Only `tailscale serve` is ever used in this phase, never the
# public-exposure mode. TS_WARN_FILTER exists purely because of the
# client/daemon version warning noted above — it is pre-existing noise, not
# a signal.
#
# 06-04.1: kanban's bind still does not change. What changed is what sits
# in front of it — TS_SERVE_TARGET above now points at the proxy
# (127.0.0.1:$KANBAN_PROXY_PORT), and the proxy's own upstream call to
# kanban always uses KANBAN_HOST/KANBAN_PORT unmodified. Kanban is never
# told to bind anywhere but loopback, by anything, in any plan.

LAN_IP="${LAN_IP:-$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)}"

export TAILSCALE_BIN TAILNET_HOSTNAME TAILNET_IP4
export TS_SERVE_PORT TS_SERVE_TARGET TS_SERVE_URL TS_WARN_FILTER
export FORBIDDEN_SERVE_PORTS EXPECTED_FUNNEL_KEY EXPECTED_FUNNEL_KEY_COUNT
export EXPECTED_SERVE_BASELINE TELEGRAM_ALLOWED_USER_ID_KEY NET04_PROBE_TOKEN
export TS_SERVE_ROLLBACK_CMD TS_SERVE_SCRATCH_PORT LAN_IP
export NODE_BIN KANBAN_PROXY_HOST KANBAN_PROXY_SCRATCH_PORT
export KANBAN_PROXY_SCRIPT KANBAN_PROXY_WRAPPER
export PROXY_UPSTREAM_HOST_HEADER PROXY_UPSTREAM_ORIGIN PROXY_PUBLIC_ORIGIN
export PROXY_ALLOWED_HOSTS PROXY_ALLOWED_ORIGINS
