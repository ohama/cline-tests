# phase-07/bench/config.env — sourced by every Phase 7 bench script.
#
# Same convention as phase-02/infra/config.env, phase-03/sandbox/config.env,
# phase-04/config.env, phase-05/services/config.env, phase-06/net/config.env:
# this is the ONLY place any Phase 7 path/spec/pid/candidate value is
# defined. Every value below uses the `${VAR:-default}` override idiom so a
# caller can override any single value without editing this file.
#
# No side effects: sourcing this file touches no process, no network, no
# disk beyond reading itself. Read-only by construction.

# Derive PROJECT_ROOT from this script's own location, not `pwd` — this
# file lives at phase-07/bench/config.env, so PROJECT_ROOT is two
# directories up.
_CONFIG_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$_CONFIG_ENV_DIR/../.." && pwd)}"

# ---- Layout ------------------------------------------------------------
BENCH_ROOT="${BENCH_ROOT:-$PROJECT_ROOT/bench}"
BENCH_REPO="${BENCH_REPO:-$BENCH_ROOT/cline-bench}"
RUNS_ROOT="${RUNS_ROOT:-$BENCH_ROOT/runs}"
CURRENT_RUN_FILE="${CURRENT_RUN_FILE:-$PROJECT_ROOT/phase-07/bench/CURRENT_RUN}"
RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/phase-07/results}"

# ---- cline-bench checkout ------------------------------------------------
CLINE_BENCH_URL="${CLINE_BENCH_URL:-https://github.com/cline/cline-bench.git}"

# ---- harbor invocation spec ----------------------------------------------
HARBOR_AGENT="${HARBOR_AGENT:-cline-cli}"

# HARBOR_MODEL_SPEC: WHY `openai-compatible:flashnext` and NOT the README's
# literal `openai:flashnext` — `openai-compatible` is a real registered
# provider id in cline's builtins (`sdk/packages/llms/src/providers/
# builtins.ts`, live-read against `cline/cline`'s `main`) and is this
# project's own already-validated provider id (docs/cline-config-pins.md,
# phase-01/config/cline-invocation.env: CLINE_PROVIDER=openai-compatible). A
# bare `openai` id was NOT found in cline's builtin provider table — see
# 07-RESEARCH.md Pitfall 3.
HARBOR_MODEL_SPEC="${HARBOR_MODEL_SPEC:-openai-compatible:flashnext}"

# HARBOR_BASE_URL: NOT localhost. Colima proxies host.docker.internal to the
# host loopback interface, so litellm's strictly-127.0.0.1 bind is reachable
# from a container with NO host bind change. Live-verified 2026-08-30 (see
# 07-RESEARCH.md Sources, "Primary" section) — `docker run --rm alpine ...
# curl http://host.docker.internal:4000/` returned 200 with the real
# flashnext model list.
HARBOR_BASE_URL="${HARBOR_BASE_URL:-http://host.docker.internal:4000/v1}"

# This stack accepts any non-empty API key; it is not a secret and is never
# treated as one.
HARBOR_API_KEY="${HARBOR_API_KEY:-local-any-value}"

# Passed as --agent-kwarg cline-version=3.0.53 — pins the container-side
# cline install to this project's validated version instead of harbor's
# default cline@nightly.
HARBOR_CLINE_VERSION="${HARBOR_CLINE_VERSION:-3.0.53}"

# The server-side token oracle, already established in
# phase-01/config/cline-invocation.env.
FLASHNEXT_ERR_LOG="${FLASHNEXT_ERR_LOG:-$HOME/llm-system/services/logs/flashnext.err}"

# ---- Standing gate inheritance -------------------------------------------
NET_BASELINE="${NET_BASELINE:-phase-06/results/20260830T051403Z-baseline}"
EXPECT_NET_CASES="${EXPECT_NET_CASES:-24}"

# ---- Live pids (bash 3.2 -- no declare -A, two parallel indexed arrays
# built by index) ------------------------------------------------------
LIVE_PIDS_STR="${LIVE_PIDS_STR:-46573 75548 48525 53894 99162 19669}"
LIVE_PID_LABELS_STR="${LIVE_PID_LABELS_STR:-flashnext role-shim litellm kanban telegram-connect kanban-proxy}"
# A third parallel array (by index, same convention): the expected
# process-name/command-line substring for each pid above, used by
# preflight.sh's P1 check as the second, independent oracle beyond "pid
# exists" (a pid existing alone does not prove it is still the SAME
# process — pids get reused). Captured live 2026-08-30 via
# `ps -ww -p <pid> -o command=`.
LIVE_PID_SUBSTR_STR="${LIVE_PID_SUBSTR_STR:-mlx_vlm.server role_shim.py litellm kanban run_telegram_service.sh kanban_host_proxy.js}"
# shellcheck disable=SC2206
LIVE_PIDS=($LIVE_PIDS_STR)
# shellcheck disable=SC2206
LIVE_PID_LABELS=($LIVE_PID_LABELS_STR)
# shellcheck disable=SC2206
LIVE_PID_SUBSTR=($LIVE_PID_SUBSTR_STR)

# ---- Disk floor -----------------------------------------------------------
# The floor this phase requires before pulling Docker images.
MIN_FREE_GIB="${MIN_FREE_GIB:-30}"

# ---- Candidate task suffixes (research-derived preferred order; resolved
# to real directory names by Task 3 against the live, measured inventory) --
CANDIDATE_SUFFIXES="${CANDIDATE_SUFFIXES:-discord-trivia-approval-keyerror
telegram-plugin-refactor
intercept-axios-error-handling
orpc-client-workspace
healthchain-prefetch-removal
police-sync-segfault
every-plugin-api-migration
filmarchiver
suave-http-data-bleeding}"

# EXCLUDED_SUFFIXES: memory_mb=8192 exceeds colima's whole 4 GiB VM, and
# colima must NOT be resized as an incidental side effect of this phase
# (07-RESEARCH.md Pitfall 5).
EXCLUDED_SUFFIXES="${EXCLUDED_SUFFIXES:-terraform-azurerm-deployment-stacks}"

SMOKE_SUFFIX="${SMOKE_SUFFIX:-discord-trivia-approval-keyerror}"

export PROJECT_ROOT BENCH_ROOT BENCH_REPO RUNS_ROOT CURRENT_RUN_FILE RESULTS_ROOT
export CLINE_BENCH_URL HARBOR_AGENT HARBOR_MODEL_SPEC HARBOR_BASE_URL
export HARBOR_API_KEY HARBOR_CLINE_VERSION FLASHNEXT_ERR_LOG
export NET_BASELINE EXPECT_NET_CASES
export LIVE_PIDS_STR LIVE_PID_LABELS_STR LIVE_PID_SUBSTR_STR
export MIN_FREE_GIB CANDIDATE_SUFFIXES EXCLUDED_SUFFIXES SMOKE_SUFFIX
