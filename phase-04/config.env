# phase-04/config.env — sourced by every phase-04 script.
#
# This is the ONLY place any phase-04 path is defined. Every script in
# phase-04/ sources this file first; nothing here should be hand-duplicated
# elsewhere.
#
# ---- THE CWD RULE (04-RESEARCH.md Pitfall 1) -------------------------------
# The sandboxed process's OS-level working directory must ALREADY be inside
# ALLOWED_REPOS.json, or Bun's own startup dies with a path-less
# `error: An unknown error occurred (Unexpected)` before any cline code runs.
# This is why SANDBOX_WORKDIR exists and why callers must really `cd` there —
# `cline -c/--cwd` is a SEPARATE, ADDITIONAL flag and does NOT substitute for
# the process cwd. Always `cd "$SANDBOX_WORKDIR"` (or otherwise set the OS
# process cwd) before invoking `phase-03/sandbox/run_sandboxed.sh`.
#
# ---- DO NOT WIDEN THE SANDBOX -----------------------------------------------
# The Pitfall 1 fix requires NO sandbox widening: phase-03/sandbox/config.env's
# EXTRA_ALLOW_PATHS stays empty, and no phase-04 script may ever set it. The
# fix is invocation hygiene (cwd), not a boundary change.
#
# ---- GITIGNORED WORKDIR ------------------------------------------------------
# workspace/scratch-repo/ is gitignored, so consumers must
# `mkdir -p "$SANDBOX_WORKDIR"` before use rather than assuming a fresh clone
# already has it.
# -----------------------------------------------------------------------------

# Derive PROJECT_ROOT from this script's own location so config.env is
# source-able from any cwd. This file lives at phase-04/config.env, so
# PROJECT_ROOT is one directory up.
_CONFIG_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$_CONFIG_ENV_DIR/.." && pwd)}"

RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/phase-04/results}"
ALLOWED_REPOS_JSON="${ALLOWED_REPOS_JSON:-$PROJECT_ROOT/workspace/ALLOWED_REPOS.json}"

# SANDBOX_WORKDIR is DERIVED as the first entry of ALLOWED_REPOS.json's
# repos[] array — never hard-coded — so the wrapper's cwd can never drift out
# of the whitelist. An existing SANDBOX_WORKDIR override (env var already
# set before sourcing this file) is honored as-is.
if [ -z "${SANDBOX_WORKDIR:-}" ]; then
  SANDBOX_WORKDIR="$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    repos = data.get("repos", [])
    if not repos:
        sys.exit(1)
    print(repos[0])
except Exception:
    sys.exit(1)
' "$ALLOWED_REPOS_JSON")"
fi
export SANDBOX_WORKDIR
