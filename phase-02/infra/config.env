# phase-02/infra/config.env — sourced by every phase-02 script.
# ---- OVERRIDE POINT (INF-01) ----------------------------------------------
# Concurrency cap handed to mlx_vlm.server as --max-num-seqs.
# 1 == full serialization: one request decodes, the next waits in the queue.
# Chosen because ROADMAP Phase 2 Success Criterion 1 literally requires
# "하나가 즉시 처리되고 다른 하나는 큐잉/지연", and headroom at 32K is only 4.39 GB.
# Raising this to 2 is a supported, one-line change and nothing else needs editing:
# verify_queueing.sh defaults its probe concurrency to MAX_NUM_SEQS + 1 and its
# cap assertion to MAX_NUM_SEQS, so a cap of 2 is automatically probed with 3
# concurrent requests. After changing it: re-run apply_max_num_seqs.sh (idempotent,
# updates in place), then 02-02 Task 3.
MAX_NUM_SEQS="${MAX_NUM_SEQS:-1}"
# ---- OVERRIDE POINT (INF-02) ----------------------------------------------
LITELLM_BIND_HOST="${LITELLM_BIND_HOST:-127.0.0.1}"
# ---------------------------------------------------------------------------
FLASHNEXT_LABEL="${FLASHNEXT_LABEL:-com.ohama.flashnext}"
ROLESHIM_LABEL="${ROLESHIM_LABEL:-com.ohama.role-shim}"
LITELLM_LABEL="${LITELLM_LABEL:-com.ohama.litellm}"
LAUNCH_AGENTS_DIR="${LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
MIRROR_AGENTS_DIR="${MIRROR_AGENTS_DIR:-$HOME/local-llm-settings/launchagents}"
FLASHNEXT_ERR="${FLASHNEXT_ERR:-$HOME/llm-system/services/logs/flashnext.err}"
MLX_MODEL_PATH="${MLX_MODEL_PATH:-/Users/ohama/projs/qwen38-flash-next-tests/models/Qwen3.8-Flash-Next-MLX-oQ4}"
MLX_PORT="${MLX_PORT:-8000}"
ROLESHIM_PORT="${ROLESHIM_PORT:-8011}"
LITELLM_PORT="${LITELLM_PORT:-4000}"
EXPECTED_WIRED_LIMIT_MB="${EXPECTED_WIRED_LIMIT_MB:-118784}"
RESULTS_ROOT="${RESULTS_ROOT:-phase-02/results}"
BACKUP_DIR="${BACKUP_DIR:-phase-02/infra/backups}"
