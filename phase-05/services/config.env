# phase-05/services/config.env — sourced by every phase-05 service script.
#
# This is the ONLY place any Phase 5 path/label/port/timeout is defined —
# same convention as phase-02/infra/config.env, phase-03/sandbox/config.env,
# phase-04/config.env. Every value below uses the `${VAR:-default}` override
# idiom so a caller can override any single value without editing this file.

# Derive PROJECT_ROOT from this script's own location so config.env is
# source-able from any cwd. This file lives at phase-05/services/config.env,
# so PROJECT_ROOT is two directories up.
_CONFIG_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$_CONFIG_ENV_DIR/../.." && pwd)}"

# ---- REUSE, DO NOT RE-DERIVE ------------------------------------------------
# Pre-set RESULTS_ROOT to phase-05's own results dir BEFORE sourcing
# phase-04/config.env. phase-04/config.env's own RESULTS_ROOT assignment uses
# the `${RESULTS_ROOT:-...}` idiom, so a value already set here wins and
# phase-04's results dir is never touched by phase-05 scripts. Sourcing it
# gives us SANDBOX_WORKDIR — derived from workspace/ALLOWED_REPOS.json,
# never hard-coded here — plus ALLOWED_REPOS_JSON, without re-deriving either
# path a second time in a second place. Ordering matters: source AFTER the
# pre-set, or phase-04's own default would win instead.
RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/phase-05/results}"
# shellcheck source=/dev/null
source "$PROJECT_ROOT/phase-04/config.env"

# ---- Phase 5 labels/ports/timeouts ------------------------------------------
KANBAN_LABEL="${KANBAN_LABEL:-com.ohama.kanban}"
TELEGRAM_LABEL="${TELEGRAM_LABEL:-com.ohama.telegram-connect}"

KANBAN_HOST="${KANBAN_HOST:-127.0.0.1}"
# kanban's own live default, pinned explicitly. NEVER 3000 (ROADMAP Phase 6
# criterion 3), NEVER `--port auto`.
KANBAN_PORT="${KANBAN_PORT:-3484}"

FLASHNEXT_HOST="${FLASHNEXT_HOST:-127.0.0.1}"
# mlx_vlm.server's OWN port — see the readiness-probe comment block below for
# why the gate targets THIS port/URL and not litellm's.
FLASHNEXT_PORT="${FLASHNEXT_PORT:-8000}"
FLASHNEXT_HEALTH_URL="${FLASHNEXT_HEALTH_URL:-http://127.0.0.1:8000/health}"
LITELLM_MODELS_URL="${LITELLM_MODELS_URL:-http://127.0.0.1:4000/v1/models}"
LITELLM_ALIAS="${LITELLM_ALIAS:-flashnext}"

UPSTREAM_WAIT_TIMEOUT="${UPSTREAM_WAIT_TIMEOUT:-300}"
UPSTREAM_WAIT_INTERVAL="${UPSTREAM_WAIT_INTERVAL:-5}"
UPSTREAM_WAIT_PROGRESS_EVERY="${UPSTREAM_WAIT_PROGRESS_EVERY:-60}"

IDLE_SLEEP_SECONDS="${IDLE_SLEEP_SECONDS:-3600}"

# Must match the ThrottleInterval in both staged plists (phase-05/plists/,
# written in a later plan — this file is the single source those plists
# should be generated/checked against).
THROTTLE_INTERVAL="${THROTTLE_INTERVAL:-30}"

LAUNCH_AGENTS_DIR="${LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
MIRROR_AGENTS_DIR="${MIRROR_AGENTS_DIR:-$HOME/local-llm-settings/launchagents}"
STAGED_PLISTS_DIR="${STAGED_PLISTS_DIR:-$PROJECT_ROOT/phase-05/plists}"
BACKUP_DIR="${BACKUP_DIR:-$PROJECT_ROOT/phase-05/services/backups}"

# ---- SERVICE_LOG_DIR (load-bearing — this is not a style choice) -----------
# launchd opens StandardOutPath/StandardErrorPath ITSELF, and the sandboxed
# child inherits those fds across exec. Redirecting a sandboxed process's
# stdio at a path that is not punched through the $HOME deny has produced a
# bare `Abort trap: 6` (SIGABRT inside Node's own bootstrap, before a single
# line of app code) four separate times in this project (03-03 F8, 03-04,
# 04-02, 04-04). The other three house services (flashnext/litellm/role-shim)
# log to $HOME/llm-system/services/logs/, which is under $HOME and is NOT
# punched — that path is fine for THEM because they never run through
# run_sandboxed.sh, but it would be exactly the wrong choice here.
# $HOME/.cline IS always punched, read AND write (confirmed in the live
# workspace/sandbox.sb: `(allow file-read* (subpath "/Users/ohama/.cline"))`
# + `(allow file-write* ...)`), so $HOME/.cline/logs/ is the log location
# that cannot resurrect that crash.
#
# THE FIX IS THE LOG PATH, NEVER EXTRA_ALLOW_PATHS — that stays empty. If
# even this path were to fail, the documented fallback is a path OUTSIDE
# $HOME entirely (the sandbox only denies under $HOME), never a widening.
SERVICE_LOG_DIR="${SERVICE_LOG_DIR:-$HOME/.cline/logs}"

# ---- READINESS TARGET (load-bearing — this is the SVC-04 correctness
# question, not a style choice) ----------------------------------------------
# The chain is litellm(:4000) -> role-shim(:8011) -> mlx_vlm.server/flashnext
# (:8000). litellm is a lightweight Python proxy that binds its own listener
# INDEPENDENTLY of whether flashnext has loaded — so a bare TCP probe against
# :4000 would return "ready" immediately in both scenarios the criterion
# cares about (flashnext deliberately down with litellm untouched; and at
# boot, where litellm binds in seconds while a 104 GiB model is still
# loading). The wait would then never engage and the retry behaviour SVC-04
# describes would never be exercised. Phase 2's verify_no_regression.sh
# already treats a bare TCP check as insufficient here for exactly this
# reason. So the readiness gate (wait_for_upstream.sh) probes flashnext
# ITSELF, and does it at the HTTP level, not litellm's port alone.

# ---- KANBAN_PROXY_LABEL / KANBAN_PROXY_PORT (identity only — this file
# owns every launchd label/port in the project once; the proxy's BEHAVIOUR
# — its allowlists, its upstream target, its host binding — is a Phase 6
# concern and lives in phase-06/net/config.env, which already sources this
# file, so both layers see one definition of "what is this thing called and
# what port does it own" instead of two.) --------------------------------
# Added by 06-04.1 to unblock 06-04: kanban's own compiled getAllowedHostHeaders()
# hardcodes {localhost:<port>, 127.0.0.1:<port>} while loopback-bound, with no
# flag/env override, so `tailscale serve` cannot reach it directly with the
# tailnet Host header. This label/port name the small loopback-only
# Host/Origin-rewriting proxy that now sits between Serve and kanban.
KANBAN_PROXY_LABEL="${KANBAN_PROXY_LABEL:-com.ohama.kanban-proxy}"
# 18484 was confirmed unclaimed by `lsof -nP -iTCP:18484` immediately before
# this file was written, and is referenced nowhere else in the repo before
# this edit. Deliberately NOT 3000/443/8443/10000 (the four
# FORBIDDEN_SERVE_PORTS), not 8444 (TS_SERVE_PORT), not 3484 (kanban's own
# KANBAN_PORT), not 59999 (TS_SERVE_SCRATCH_PORT). Deliberately far outside
# the range kanban's own `--port auto` scan would walk, so a stray kanban
# instance started with `--port auto` can never collide with it.
KANBAN_PROXY_PORT="${KANBAN_PROXY_PORT:-18484}"

export RESULTS_ROOT SANDBOX_WORKDIR ALLOWED_REPOS_JSON
export KANBAN_LABEL TELEGRAM_LABEL KANBAN_HOST KANBAN_PORT
export FLASHNEXT_HOST FLASHNEXT_PORT FLASHNEXT_HEALTH_URL
export LITELLM_MODELS_URL LITELLM_ALIAS
export UPSTREAM_WAIT_TIMEOUT UPSTREAM_WAIT_INTERVAL UPSTREAM_WAIT_PROGRESS_EVERY
export IDLE_SLEEP_SECONDS THROTTLE_INTERVAL
export LAUNCH_AGENTS_DIR MIRROR_AGENTS_DIR STAGED_PLISTS_DIR BACKUP_DIR
export SERVICE_LOG_DIR
export KANBAN_PROXY_LABEL KANBAN_PROXY_PORT
