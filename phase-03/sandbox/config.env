# phase-03/sandbox/config.env — sourced by every phase-03 sandbox script.
#
# This is the ONLY place any phase-03 path is defined. Every script in
# phase-03/sandbox/ sources this file first; nothing here should be
# hand-duplicated elsewhere.
#
# ---- SCOPE LIMITATION (stated, not hidden) --------------------------------
# The generated profile uses `(allow default)` with an explicit deny on
# PROTECTED_ROOT. It protects $HOME. It is NOT a total-deny jail — anything
# outside $HOME (/tmp, /opt, /usr/local, and any externally mounted volume or
# network share) stays readable and writable by the sandboxed process.
# 03-RESEARCH.md found no other mount points on this machine needing
# protection and this is an accepted, deliberate scope boundary. Revisit if
# the machine's storage layout changes. `(deny default)` was tried and
# rejected: it crashes real binaries with SIGABRT and zero diagnostics as
# soon as dyld cannot read a runtime dependency.
# ---------------------------------------------------------------------------

# Derive PROJECT_ROOT from this script's own location so config.env is
# source-able from any cwd. This file lives at phase-03/sandbox/config.env,
# so PROJECT_ROOT is two directories up.
_CONFIG_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$_CONFIG_ENV_DIR/../.." && pwd)}"

WORKSPACE_DIR="${WORKSPACE_DIR:-$PROJECT_ROOT/workspace}"
ALLOWED_REPOS_JSON="${ALLOWED_REPOS_JSON:-$WORKSPACE_DIR/ALLOWED_REPOS.json}"
SANDBOX_PROFILE="${SANDBOX_PROFILE:-$WORKSPACE_DIR/sandbox.sb}"

# ---- OVERRIDE POINT (SBX-01/02/03) -----------------------------------------
# PROTECTED_ROOT is the realpath'd root the generator denies file-read*/
# file-write* under, before punching through each ALLOWED_REPOS.json entry.
PROTECTED_ROOT="${PROTECTED_ROOT:-$HOME}"

# Cline's own config/data dir — always punched through, since it lives under
# $HOME and would otherwise be caught by the PROTECTED_ROOT deny above.
CLINE_DATA_DIR="${CLINE_DATA_DIR:-$HOME/.cline}"

# ---- OVERRIDE POINT (the ONLY sanctioned widening point) -------------------
# EXTRA_ALLOW_PATHS is colon-separated and EMPTY by default. Each entry is
# punched through the PROTECTED_ROOT deny exactly like an ALLOWED_REPOS.json
# repo entry. The bounded candidate list this may reasonably be set to:
#   $HOME/.npm, $HOME/.cache, $HOME/.config/cline, $HOME/Library/Caches/cline
# Anything broader than a specific Cline-owned directory (e.g. all of
# $HOME/Library, or $HOME itself) is NOT a sanctioned entry and must be
# escalated to a human instead of added here.
EXTRA_ALLOW_PATHS="${EXTRA_ALLOW_PATHS:-}"

BENCH_DIR="${BENCH_DIR:-$PROJECT_ROOT/bench}"
RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/phase-03/results}"
FIXTURES_ROOT="${FIXTURES_ROOT:-$PROJECT_ROOT/phase-03/fixtures}"
