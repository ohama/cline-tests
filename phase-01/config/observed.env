# phase-01/config/observed.env
#
# Sole writer: Plan 01-05 (CFG-03 max_tokens observation). Written ONCE,
# atomically (`> tmp && mv`). NEVER delete — Plan 04's run_regression.sh
# reads this via OBSERVED_ENV_PATH indirection in the same wave.
#
# Sourced AFTER phase-01/config/cline-invocation.env — every value below
# is the measured/derived authority, overriding that file's cross-check-only
# defaults (CLINE_PREDICTED_TRIGGER_TOKENS=26542 there is a default at
# contextWindow=32768; this file republishes the value actually derived
# from the live providers.json so it stays correct even if a future branch
# changes contextWindow).

# Measured from ~/llm-system/services/logs/flashnext.err (the token oracle;
# flashnext.log is NOT used), NOT assumed from providers.json's configured
# `maxTokens` field. Evidence: phase-01/results/max-tokens-probe/observed_lines.txt
#   "Generation queued: request=82eb9186e0 prompt_tokens=5495 max_tokens=2048 ..."
# This does NOT match providers.json's configured maxTokens=4096 -- Cline's
# maxTokens field is not honored by this build (root cause unknown, see
# docs/cline-max-tokens-findings.md).
export CLINE_OBSERVED_MAX_TOKENS=2048

# Branch taken (A|B1|B2|B3). A = OBSERVED_MAX < 6226 at the live contextWindow
# (32768) -> no mitigation needed; Cline's own internal cap already leaves
# room under the server's 32768 accept-time budget for the compaction trigger
# to fire before the wall. See docs/cline-max-tokens-findings.md section 4.
export CLINE_MAX_TOKENS_BRANCH=A

# The contextWindow actually present in ~/.cline/data/settings/providers.json
# at observation time (confirmed by direct read, not assumed). Branch A took
# no action on this value; it remains the CFG-02 value.
export CLINE_CONFIGURED_CONTEXT_WINDOW=32768

# Derived from the CONFIGURED_CONTEXT_WINDOW above via
# int(contextWindow * 0.9 * 0.9), NOT copied from the 26542 literal default
# in cline-invocation.env (they happen to agree under Branch A because
# contextWindow was not changed, but this value is computed here so a future
# branch change can never leave a stale number behind).
export CLINE_PREDICTED_TRIGGER_TOKENS=26542

# ISO-8601 UTC timestamp of the probe in Task 1 that produced OBSERVED_MAX_TOKENS.
export CLINE_MAX_TOKENS_OBSERVED_AT=2026-08-29T09:17:58Z
